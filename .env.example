NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
APP_URL=http://localhost:3000
# Set false locally on ExFAT if AppleDouble metadata breaks Turbopack caches.
# Omit on production hosts to retain Next.js's default filesystem cache.
TURBOPACK_FILESYSTEM_CACHE=false
# Enable only after Microsoft Entra and Supabase Azure provider are configured.
AUTH_MICROSOFT_ENABLED=false
GEMINI_API_KEY=
# Select an image-capable model available to your Google project.
GEMINI_MODEL=gemini-3.6-flash
CRON_SECRET=
# A monitored inbox for support and data/deletion requests; required at launch.
SUPPORT_EMAIL=
# App notifications (separate from Supabase sign-in email). Use a verified sender.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
