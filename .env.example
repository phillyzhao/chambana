NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
APP_URL=http://localhost:3000
# Private random secret (at least 32 characters) for the shared preview/sign-in gate.
# Set on every production instance; missing configuration keeps access closed.
PREVIEW_ACCESS_SECRET=
# Enables the code-gated iOS preview and its homepage link on this host.
CHAMBANA_DESIGN_PREVIEW=false
# Set false locally on ExFAT if AppleDouble metadata breaks Turbopack caches.
# Omit on production hosts to retain Next.js's default filesystem cache.
TURBOPACK_FILESYSTEM_CACHE=false
# Enable only after Microsoft Entra and Supabase Azure provider are configured.
AUTH_MICROSOFT_ENABLED=false
GEMINI_API_KEY=
# Select an image-capable model available to your Google project.
GEMINI_MODEL=gemini-3.6-flash
CRON_SECRET=
# A monitored inbox for support and data/deletion requests; required at launch.
SUPPORT_EMAIL=
# App notifications (separate from Supabase sign-in email). Use a verified sender.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=

# Separate owner credential (random, at least 32 characters) for /mission-admin.
# Never use the public preview code here; keep this out of client bundles and Git.
MISSION_ADMIN_SECRET=
# Default OFF. Enable only after the owner approves delivering the shared catalog.
# Per-mission explicit approval and its Central-time schedule are also required.
CHAMBANA_MISSION_LIBRARY_ENABLED=false
